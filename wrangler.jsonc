{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beiershuo",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "beiershuo.chenxi.dev", "custom_domain": true }
  ],
  // Only the statistics relay runs code; every other request is a free static-asset hit.
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/stardust/*"]
  }
}
